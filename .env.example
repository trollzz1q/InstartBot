BOT_TOKEN=сюда_токен_от_BotFather
# chat id Марины: она пишет боту /start, затем /myid, и бот присылает число
ADMIN_CHAT_ID=
# Кто может загрузить PDF-гайд, отправив файл боту в личку (id через запятую; /myid покажет id).
# Марина из ADMIN_CHAT_ID тоже может.
UPLOAD_IDS=
# Если Telegram у тебя грузится только через VPN/прокси, укажи его (необязательно)
# PROXY_URL=http://127.0.0.1:7890
